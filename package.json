{
  "name": "dsh-bili-whale",
  "version": "0.4.6",
  "description": "养一条有日子的鱼：让 DSH 里的 agent 自己刷 B 站、看懂视频、写两本日记，把值得的 @ 你。设置里有「养鱼」完整设置页（27 项）+ 依赖体检 + cookie 写入 + 共享配置（与工具链同一份 bili-whale.config.json）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "agent",
    "diary"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:observer": "node tools/observer-ui/build.mjs",
    "prepack": "node tools/observer-ui/build.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "tests",
    "AUDIT-FIXES.md",
    "RISK-PROTECTION.md",
    "AI-SHARE-TRIAL.md",
    "LOCAL-UPDATE.md",
    "ISSUE27-FIX.md",
    "LISTENER-FIX.md",
    "DM-HISTORY-FIX.md",
    "BUGFIX-2026-10-25.md",
    "QR-LOGIN-2026-10-25.md",
    "docs",
    "tools/observer-ui/dist",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "qrcode": "1.5.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@tabler/icons-react": "3.50.0",
    "diff": "9.0.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
